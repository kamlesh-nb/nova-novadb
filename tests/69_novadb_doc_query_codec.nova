// The NovaDB driver's document QUERY-surface wire codec (src/codec.nova, D-11):
// the extended document opcodes (find_query / count / insert_many / find_cursor /
// create_index) and the cursor-result ('j' with a next id) decode. Gated OFFLINE
// against hand-built byte buffers matching btree proto/wire.zig.
import assert;
import bytes;
import string;
import list;
import codec;

fn byte1(b: int): string {
    let p = bytes.alloc(1);
    bytes.write_byte(p, 0, b);
    return p as string;
}
fn u32b(v: int): string {
    let p = bytes.alloc(4);
    bytes.write_byte(p, 0, (v / 16777216) % 256);
    bytes.write_byte(p, 1, (v / 65536) % 256);
    bytes.write_byte(p, 2, (v / 256) % 256);
    bytes.write_byte(p, 3, v % 256);
    return p as string;
}

@test
fn test_query_ops_carry_the_right_opcode(): void {
    // Byte 5 of the frame (first payload byte) is the op code.
    assert.equalInt(codec.buildDocCreateIndexFrame("c", "price")[5], 10);
    assert.equalInt(codec.buildDocFindQueryFrame("c", "x")[5], 11);
    assert.equalInt(codec.buildDocCountFrame("c", "x")[5], 12);
    assert.equalInt(codec.buildDocInsertManyFrame("c", "x")[5], 13);
    assert.equalInt(codec.buildDocFindCursorFrame("c", "x")[5], 14);
}

@test
fn test_decode_cursor_result_with_next(): void {
    // has_next=1, a 12-byte id, then count(1) + one doc "aaa".
    let id = "ABCDEFGHIJKL";   // 12 bytes
    let payload = byte1(1) + id + u32b(1) + u32b(3) + "aaa";
    let page = codec.decodeDocCursorResult(payload);
    assert.equalInt(page.docs.size(), 1);
    assert.equalStr(page.docs.get(0) ?? "", "aaa");
    assert.equalInt(page.next.length, 12);
    assert.equalStr(page.next, id);
}

@test
fn test_write_ops_carry_the_right_opcode(): void {
    assert.equalInt(codec.buildDocDeleteFrame("c", "x")[5], 8);
    assert.equalInt(codec.buildDocUpdateFrame("c", "f", "s")[5], 9);
    assert.equalInt(codec.buildDocUpsertFrame("c", "f", "s")[5], 15);
    assert.equalInt(codec.buildDocBulkWriteFrame("c", "x")[5], 16);
    assert.equalInt(codec.buildDocAggregateFrame("c", "x")[5], 17);
}

@test
fn test_update_payload_layout(): void {
    // buildUpdatePayload = u32(filter.length) + filter + spec.
    let p = codec.buildUpdatePayload("ff", "sss");   // filter len 2, spec len 3
    assert.equalInt(p.length, 4 + 2 + 3);
    // big-endian length of 2.
    assert.equalInt(p[0], 0);
    assert.equalInt(p[1], 0);
    assert.equalInt(p[2], 0);
    assert.equalInt(p[3], 2);
    assert.equalStr(string.slice(p, 4, 6), "ff");
    assert.equalStr(string.slice(p, 6, p.length), "sss");
}

@test
fn test_decode_cursor_result_exhausted(): void {
    // has_next=0 -> no id, empty next; two docs.
    let payload = byte1(0) + u32b(2) + u32b(2) + "bb" + u32b(4) + "cccc";
    let page = codec.decodeDocCursorResult(payload);
    assert.equalInt(page.docs.size(), 2);
    assert.equalStr(page.docs.get(0) ?? "", "bb");
    assert.equalStr(page.docs.get(1) ?? "", "cccc");
    assert.equalInt(page.next.length, 0);   // exhausted -> empty resume id
}
