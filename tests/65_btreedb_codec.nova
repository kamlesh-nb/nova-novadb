// The typed NovaDB driver's wire CODEC (data/btree/bt_codec.nova) — gated OFFLINE against
// hand-built byte buffers matching the binary protocol (btree proto/wire.zig), so the
// encode/decode is verified without a live server. Covers: request-frame encoding, typed
// RowDescription + DataRow decode (int/text/bool/NULL), CommandComplete + Error decode,
// and client-side $N parameter substitution with the server's escaping.
import assert;
import bytes;
import string;
import list;
import db;
import bt_codec;
import bt_typemap;

// Local big-endian byte-string builders (mirror the server's encoding) to synthesize wire
// payloads. A Nova string is a length-headed byte buffer, so `+` concatenation is binary-safe.
fn u16b(v: int): string {
    let p = bytes.alloc(2);
    bytes.write_byte(p, 0, (v / 256) % 256);
    bytes.write_byte(p, 1, v % 256);
    return p as string;
}
fn u32b(v: int): string {
    let p = bytes.alloc(4);
    bytes.write_byte(p, 0, (v / 16777216) % 256);
    bytes.write_byte(p, 1, (v / 65536) % 256);
    bytes.write_byte(p, 2, (v / 256) % 256);
    bytes.write_byte(p, 3, v % 256);
    return p as string;
}
fn s16(s: string): string { return u16b(s.length) + s; }

// RowDescription field: name, table_id(u32), col_no(u16), type_oid(u32), type_size(u16),
// type_mod(u32), format(u16).
fn field(name: string, oid: int, size: int): string {
    return s16(name) + u32b(0) + u16b(0) + u32b(oid) + u16b(size) + u32b(0) + u16b(0);
}

@test
fn test_request_frame_encoding(): void {
    // 'Q' query frame: [81][u32 len][u16 slen]["Q"]. len = 4 + (2 + 1) = 7.
    let f = bt_codec.buildQueryFrame("Q");
    assert.equalInt(f.length, 8);           // 1 + 4 + 2 + 1
    assert.equalInt(f[0], 81);              // 'Q'
    assert.equalInt(f[1], 0);
    assert.equalInt(f[2], 0);
    assert.equalInt(f[3], 0);
    assert.equalInt(f[4], 7);               // length = 7
    assert.equalInt(f[5], 0);
    assert.equalInt(f[6], 1);               // slen = 1
    assert.equalInt(f[7], 81);              // 'Q'
}

@test
fn test_rowdesc_decode_types(): void {
    // Columns: id INT4(2), name TEXT(9), active BOOL(1).
    let rd = u16b(3) + field("id", 2, 4) + field("name", 9, 65535) + field("active", 1, 1);
    let cols = bt_codec.decodeRowDesc(rd);
    assert.equalInt(cols.size(), 3);

    let c0 = cols.get(0) ?? Column("", DbType.Null);
    assert.equalStr(c0.name, "id");
    assert.isTrue(c0.type_oid == DbType.Int4);

    let c1 = cols.get(1) ?? Column("", DbType.Null);
    assert.equalStr(c1.name, "name");
    assert.isTrue(c1.type_oid == DbType.Text);

    let c2 = cols.get(2) ?? Column("", DbType.Null);
    assert.isTrue(c2.type_oid == DbType.Bool);
}

@test
fn test_datarow_typed_decode(): void {
    let rd = u16b(3) + field("id", 2, 4) + field("name", 9, 65535) + field("active", 1, 1);
    let cols = bt_codec.decodeRowDesc(rd);

    // Row: id=1, name="ada", active=true  (text-format values).
    let dr = u16b(3) + u32b(1) + "1" + u32b(3) + "ada" + u32b(4) + "true";
    let row = bt_codec.decodeDataRow(dr, cols);
    assert.equalInt(row.getInt(0), 1);       // typed int, not the string "1"
    assert.equalStr(row.getText(1), "ada");
    assert.isTrue(row.getBool(2));

    // Row with a NULL: id=2, name=NULL (len -1), active=false.
    let dr2 = u16b(3) + u32b(1) + "2" + u32b(4294967295) + u32b(5) + "false";
    let row2 = bt_codec.decodeDataRow(dr2, cols);
    assert.equalInt(row2.getInt(0), 2);
    assert.isTrue(row2.isNull(1));
    assert.isTrue(!row2.getBool(2));
}

@test
fn test_tag_and_error_decode(): void {
    // CommandComplete 'C' payload is a str16 tag.
    let tag = bt_codec.decodeTag(s16("SELECT 2"));
    assert.equalStr(tag, "SELECT 2");

    // ErrorResponse 'E' payload: severity, code, message (each str16).
    let ep = s16("ERROR") + s16("42P01") + s16("no such table");
    let err = bt_codec.decodeError(ep);
    assert.equalStr(err.code, "42P01");
    assert.equalStr(err.message, "no such table");
    assert.isTrue(!err.isEmpty());

    // T1: query/exec now put a decoded 'E' frame on the result instead of dropping it.
    let rs = db.errorResult(err);
    assert.isTrue(rs.hasError());
    assert.equalStr(rs.err.code, "42P01");
    assert.isTrue(db.errorExec(err).hasError());
    assert.isTrue(!db.ResultSet().hasError());
}

@test
fn test_param_substitution(): void {
    let params = List<DbValue>();
    params.push(db.dbInt(42));
    params.push(db.dbText("o'brien"));   // must be escaped -> 'o''brien'
    let sql = bt_typemap.substituteParams("INSERT INTO t VALUES ($1, $2)", params);
    assert.equalStr(sql, "INSERT INTO t VALUES (42, 'o''brien')");

    // NULL and bool.
    let p2 = List<DbValue>();
    p2.push(db.dbNull());
    p2.push(db.dbBool(true));
    let sql2 = bt_typemap.substituteParams("VALUES ($1, $2)", p2);
    assert.equalStr(sql2, "VALUES (NULL, true)");
}

@test
fn test_multidigit_param_and_blob(): void {
    // T4: multi-digit $N + binary-safe bytea literal.
    let p = List<DbValue>();
    let i = 0;
    while (i < 11) { p.push(db.dbInt(i + 1)); i = i + 1; }
    assert.equalStr(bt_typemap.substituteParams("VALUES ($1, $10, $11)", p), "VALUES (1, 10, 11)");
    let pb = List<DbValue>();
    pb.push(db.dbBlob("Hi"));
    assert.equalStr(bt_typemap.substituteParams("$1", pb), "'\\x4869'");
}

// --- T14: extended query protocol (Parse/Bind/Execute/Sync) frame bytes -------

@test
fn test_parse_frame_encoding(): void {
    // Parse 'P' (80): [stmt][sql][u16 param_count][u32 oid]*. One int param (dbInt -> Int4 oid 2).
    let params = List<DbValue>();
    params.push(db.dbInt(7));
    let f = bt_codec.buildParseFrame("s0", "SELECT * FROM t WHERE id = $1", params);
    assert.equalInt(f[0], 80);                 // 'P'
    // Payload = s16("s0") + s16(sql) + u16(1) + u32(2). Assert framed length header + payload structure.
    let sql = "SELECT * FROM t WHERE id = $1";
    let expectPayload = s16("s0") + s16(sql) + u16b(1) + u32b(2);
    // Framed = [80][u32 len=4+payloadLen][payload].
    assert.equalInt(f.length, 5 + expectPayload.length);
    // Length field is big-endian 4 + payloadLen.
    let plen = 4 + expectPayload.length;
    assert.equalInt(f[1], (plen / 16777216) % 256);
    assert.equalInt(f[2], (plen / 65536) % 256);
    assert.equalInt(f[3], (plen / 256) % 256);
    assert.equalInt(f[4], plen % 256);
    // Payload bytes match exactly (stmt name, sql, param count 1, oid 2).
    let tail = string.slice(f, 5, f.length);
    assert.equalStr(tail, expectPayload);
}

@test
fn test_parse_param_oids_by_kind(): void {
    // Each bound value's kind maps to its wire OID in the Parse frame.
    let params = List<DbValue>();
    params.push(db.dbText("x"));      // oid 9 (text)
    params.push(db.dbBool(true));     // oid 1 (bool)
    params.push(db.dbLong(5));        // oid 3 (int8)
    params.push(db.dbDouble(1.5));    // oid 7 (float8)
    let f = bt_codec.buildParseFrame("s1", "$1$2$3$4", params);
    // Payload tail: after s16("s1") + s16("$1$2$3$4") + u16(4) come four u32 OIDs.
    let head = s16("s1") + s16("$1$2$3$4") + u16b(4);
    let oids = u32b(9) + u32b(1) + u32b(3) + u32b(7);
    let expectPayload = head + oids;
    let tail = string.slice(f, 5, f.length);
    assert.equalStr(tail, expectPayload);
}

@test
fn test_bind_frame_encoding(): void {
    // Bind 'B' (66): [portal][stmt][u16 fmt_count=0][u16 param_count][value]*[u16 rfmt_count=0].
    // value = [i32 len][bytes] (text format), or i32 -1 for NULL. Server re-quotes by class,
    // so the raw text ("o'brien") is sent UNescaped (unlike the simple-query path).
    let params = List<DbValue>();
    params.push(db.dbInt(42));          // "42"
    params.push(db.dbText("o'brien"));  // "o'brien" (raw, not doubled)
    params.push(db.dbNull());           // i32 -1
    let f = bt_codec.buildBindFrame("s0", "s0", params);
    assert.equalInt(f[0], 66);          // 'B'
    let val42 = u32b(2) + "42";
    let valTxt = u32b(7) + "o'brien";
    // i32 -1 = 0xFFFFFFFF.
    let valNull = u32b(4294967295);
    let expectPayload = s16("s0") + s16("s0") + u16b(0) + u16b(3) + val42 + valTxt + valNull + u16b(0);
    let tail = string.slice(f, 5, f.length);
    assert.equalStr(tail, expectPayload);
}

@test
fn test_execute_and_sync_frames(): void {
    // Execute 'E' (69): [portal][u32 max_rows].
    let e = bt_codec.buildExecuteFrame("s0", 0);
    assert.equalInt(e[0], 69);          // 'E'
    let expectE = s16("s0") + u32b(0);
    assert.equalStr(string.slice(e, 5, e.length), expectE);

    // Sync 'S' (83): empty payload; framed length is exactly 5 (type + u32 len=4).
    let s = bt_codec.buildSyncFrame();
    assert.equalInt(s[0], 83);          // 'S'
    assert.equalInt(s.length, 5);
    assert.equalInt(s[4], 4);           // len = 4 (includes itself, no payload)
}

@test
fn test_password_and_auth_method(): void {
    // Password 'p' (112): [u16 len][password].
    let f = bt_codec.buildPasswordFrame("s3cret");
    assert.equalInt(f[0], 112);         // 'p'
    assert.equalStr(string.slice(f, 5, f.length), s16("s3cret"));

    // Auth 'R' payload decode: a u32 method. 3 = cleartext password request.
    let payload = u32b(3);
    assert.equalInt(bt_codec.authMethod(payload), 3);
    assert.equalInt(bt_codec.authMethod(u32b(0)), 0);   // AuthenticationOk
}

@test
fn test_startup_frame_carries_creds(): void {
    // Startup 'H' (72): [u16 major][u16 minor][user][db]["nova-driver"]. Wires the DSN user/db.
    let f = bt_codec.buildStartupFrame("kamlesh", "shop");
    assert.equalInt(f[0], 72);          // 'H'
    let expect = u16b(1) + u16b(0) + s16("kamlesh") + s16("shop") + s16("nova-driver");
    assert.equalStr(string.slice(f, 5, f.length), expect);
}
