// btreedb.nova — the TYPED Nova driver for BTreeDB, implementing the `db` seam
// (db.Connection / db.Driver) over the standardized binary wire protocol.
//
// Framing: [type:u8][len:u32 BE][payload], len includes its own 4 bytes (pg convention).
// The simple-query path ('Q') carries TEXT-format values (btree proto/wire.zig FieldDesc
// defaults format=text and the executor materializes cells as text); this driver captures
// each column's type OID from RowDescription and decodes each DataRow cell into a typed
// db.DbValue accordingly — unlike data/btree/client.nova, which keeps every cell a string.
//
//   let drv = BTreeDriver();
//   let conn = drv.connect("127.0.0.1:3009");
//   let rs = conn.query("SELECT id, name FROM users", List<DbValue>());
//   let id = rs.row(0).getInt(0);   // typed, not a string
//
// The wire CODEC (frame build + response decode + param substitution) is pure over byte
// buffers, so it is gated offline (64-bit-verified) without a live server; the connect/
// query methods wire that codec to a TcpStream and need a running BTreeDB to exercise.
import net.aio;
import net.asynctls;
import io.file;
import bytes;
import string;
import list;
import db;

// --- Type OIDs (btree proto/wire.zig) -> seam DbType -------------------------
fn oidToDbType(oid: int): DbType {
    if (oid == 1) { return DbType.Bool; }
    if (oid == 2) { return DbType.Int4; }
    if (oid == 3) { return DbType.Int8; }
    if (oid == 4) { return DbType.Uint4; }
    if (oid == 5) { return DbType.Uint8; }
    if (oid == 6) { return DbType.Float4; }
    if (oid == 7) { return DbType.Float8; }
    if (oid == 8) { return DbType.Timestamp; }
    if (oid == 9) { return DbType.Text; }
    if (oid == 10) { return DbType.Blob; }
    if (oid == 11) { return DbType.Decimal; }
    return DbType.Text;
}

// --- BtFrame writers — build framed messages as binary-safe Nova strings --------
fn byte1(b: int): string {
    let p = bytes.alloc(1);
    bytes.write_byte(p, 0, b);
    return p as string;
}
fn u16be(v: int): string {
    let p = bytes.alloc(2);
    bytes.write_byte(p, 0, (v / 256) % 256);
    bytes.write_byte(p, 1, v % 256);
    return p as string;
}
fn u32be(v: int): string {
    let p = bytes.alloc(4);
    bytes.write_byte(p, 0, (v / 16777216) % 256);
    bytes.write_byte(p, 1, (v / 65536) % 256);
    bytes.write_byte(p, 2, (v / 256) % 256);
    bytes.write_byte(p, 3, v % 256);
    return p as string;
}
fn wstr16(s: string): string { return u16be(s.length) + s; }
fn frameOf(t: int, payload: string): string { return byte1(t) + u32be(4 + payload.length) + payload; }

/// Build the frames (pub for offline encode gating).
pub fn buildStartupFrame(user: string, dbname: string): string {
    let sp = u16be(1) + u16be(0) + wstr16(user) + wstr16(dbname) + wstr16("nova-driver");
    return frameOf(72, sp);   // 'H'
}
pub fn buildQueryFrame(sql: string): string { return frameOf(81, wstr16(sql)); } // 'Q'
pub fn buildTerminateFrame(): string { return frameOf(88, ""); }                 // 'X'

// A cleartext-password response ('p') — sent only if the server issues an AuthenticationCleartextPassword
// request (method 3). The current btree server accepts startup unconditionally (session.zig sends AuthOk
// method 0 without challenging), so this frame is dormant against today's server but keeps the driver
// correct if the server later enforces password auth.
pub fn buildPasswordFrame(password: string): string { return frameOf(112, wstr16(password)); } // 'p'

// --- Extended query protocol: Parse / Bind / Execute / Sync (T14) ------------
// The btree server implements the extended path SERVER-SIDE (btree proto/session.zig):
//   'P' Parse   -> stores a named prepared statement + a ParamClass per declared param OID
//   'B' Bind    -> looks up the statement, substitutes the bound param VALUES into the SQL
//                  server-side (proto/command.zig, class-driven escaping), creates a portal
//   'E' Execute -> runs the portal, streams RowDescription/DataRow*/CommandComplete
//   'S' Sync    -> flushes and replies ReadyForQuery ('Z')
// So Bind is REAL server-side substitution (the client sends raw typed values; the server quotes/
// validates), not the client-side text splice the simple-query path uses. The Parse declares each
// param's type OID; the server maps OID -> class (text/blob=quoted, bool=normalized, else=numeric-
// validated). Bind param VALUES are sent in TEXT format ([i32 len][bytes], len -1 = NULL); the server
// ignores the format codes and re-quotes by class, so we send raw unescaped text here (NOT the escaped
// literal the simple path builds).

// Map a bound value's kind to the wire type OID the server classifies for escaping.
// Timestamp is carried as ISO text, so it is declared as text(9) => quoted (a numeric class would
// reject the ISO string as a non-numeric literal server-side).
fn paramOid(v: DbValue): int {
    if (v.isNull()) { return 9; }                 // text class (safe quoting)
    let k = v.kind;
    if (k == DbType.Bool) { return 1; }
    if (k == DbType.Int4) { return 2; }
    if (k == DbType.Int8) { return 3; }
    if (k == DbType.Uint4) { return 4; }
    if (k == DbType.Uint8) { return 5; }
    if (k == DbType.Float4) { return 6; }
    if (k == DbType.Float8) { return 7; }
    if (k == DbType.Text) { return 9; }
    if (k == DbType.Blob) { return 10; }
    if (k == DbType.Decimal) { return 11; }
    return 9;                                       // Timestamp + fallback -> text class
}

// The RAW text-format value for a bound param (the server applies class escaping, so no quoting here).
fn paramValueText(v: DbValue): string {
    if (v.kind == DbType.Bool) { if (v.asBool()) { return "true"; } return "false"; }
    if (v.kind == DbType.Text || v.kind == DbType.Blob) { return v.asText(); }
    if (v.kind == DbType.Timestamp || v.kind == DbType.Decimal) { return v.asText(); }
    if (v.kind == DbType.Float4 || v.kind == DbType.Float8) {
        let d = v.asDouble();
        return `${d}`;
    }
    let iv = v.asLong();
    return `${iv}`;
}

// Encode one Bind param VALUE: [i32 len][bytes], or i32 -1 for NULL.
fn bindValue(v: DbValue): string {
    if (v.isNull()) {
        let p = bytes.alloc(4);
        bytes.write_byte(p, 0, 255);
        bytes.write_byte(p, 1, 255);
        bytes.write_byte(p, 2, 255);
        bytes.write_byte(p, 3, 255);   // i32 -1 (0xFFFFFFFF) = SQL NULL
        return p as string;
    }
    let t = paramValueText(v);
    return u32be(t.length) + t;
}

/// Parse ('P'): [stmt_name][sql][u16 param_count][u32 oid]*  — declares a named statement.
pub fn buildParseFrame(name: string, sql: string, params: List<DbValue>): string {
    let p = wstr16(name) + wstr16(sql) + u16be(params.size());
    let i = 0;
    while (i < params.size()) {
        p = p + u32be(paramOid(params.get(i) ?? db.dbNull()));
        i = i + 1;
    }
    return frameOf(80, p);   // 'P'
}

/// Bind ('B'): [portal][stmt][u16 fmt_count=0][u16 param_count][value]*[u16 result_fmt_count=0].
/// 0 param formats => all text (server re-quotes by class); 0 result formats => text results.
pub fn buildBindFrame(portal: string, stmt: string, params: List<DbValue>): string {
    let p = wstr16(portal) + wstr16(stmt) + u16be(0) + u16be(params.size());
    let i = 0;
    while (i < params.size()) {
        p = p + bindValue(params.get(i) ?? db.dbNull());
        i = i + 1;
    }
    p = p + u16be(0);        // 0 result formats
    return frameOf(66, p);   // 'B'
}

/// Execute ('E'): [portal][u32 max_rows]. max_rows 0 = all rows in one stream.
pub fn buildExecuteFrame(portal: string, maxRows: int): string {
    return frameOf(69, wstr16(portal) + u32be(maxRows));   // 'E'
}

/// Sync ('S'): empty payload; the server replies ReadyForQuery ('Z').
pub fn buildSyncFrame(): string { return frameOf(83, ""); }   // 'S'

// A per-handle statement/portal name. The server replaces a same-named prepared statement on re-Parse,
// so reusing the name across calls of the same handle is safe (and cheap).
fn stmtName(handle: int): string { return `s${handle}`; }

// --- Client-side parameter substitution --------------------------------------
// The simple-query path takes SQL text only, so $1..$N are substituted here with the SAME
// escaping the server uses (btree proto/command.zig): text single-quoted with doubled
// quotes, numeric/decimal inserted raw, bool -> true/false, NULL -> NULL. Injection-safe
// because a text value's quotes are doubled and it is never re-parsed as SQL structure.
// This is used by the SIMPLE-query ('Q') path (query/exec). The prepared methods now use the
// EXTENDED Parse/Bind/Execute path where the SERVER substitutes — see buildParseFrame above.
fn escapeText(s: string): string {
    let out = "'";
    let i = 0;
    let n = s.length;
    while (i < n) {
        let ch = s[i];
        if (ch == 39) { out = out + "''"; }   // ' -> ''
        else { out = out + string.slice(s, i, i + 1); }
        i = i + 1;
    }
    return out + "'";
}
// bytea literal '\xHEX' -- binary-safe (NUL/quotes), unlike text-escaping raw bytes.
fn byteaLiteral(s: string): string {
    let out = "'\\x";
    let i = 0;
    while (i < s.length) {
        let b = s[i];
        out = out + btHexDigit((b / 16) & 15) + btHexDigit(b & 15);
        i = i + 1;
    }
    return out + "'";
}
fn btHexDigit(v: int): string {
    if (v < 10) { return string.slice("0123456789", v, v + 1); }
    return string.slice("abcdef", v - 10, v - 10 + 1);
}
fn valueToSql(v: DbValue): string {
    if (v.isNull()) { return "NULL"; }
    if (v.kind == DbType.Bool) { if (v.asBool()) { return "true"; } return "false"; }
    if (v.kind == DbType.Blob) { return byteaLiteral(v.asText()); }
    if (v.kind == DbType.Text) { return escapeText(v.asText()); }
    if (v.kind == DbType.Decimal) { return v.asText(); }   // decimal carried as text
    if (v.kind == DbType.Float4 || v.kind == DbType.Float8) {
        let d = v.asDouble();
        return `${d}`;
    }
    let iv = v.asLong();
    return `${iv}`;
}
pub fn substituteParams(sql: string, params: List<DbValue>): string {
    let out = "";
    let i = 0;
    let n = sql.length;
    while (i < n) {
        let ch = sql[i];
        // '$' + one or more digits -> parameter N (1-based). Multi-digit required for >9-column ORM inserts.
        if (ch == 36 && i + 1 < n && sql[i + 1] >= 48 && sql[i + 1] <= 57) {
            let j = i + 1;
            let num = 0;
            while (j < n && sql[j] >= 48 && sql[j] <= 57) { num = num * 10 + (sql[j] - 48); j = j + 1; }
            let p = params.get(num - 1) ?? db.dbNull();
            out = out + valueToSql(p);
            i = j;
        } else {
            out = out + string.slice(sql, i, i + 1);
            i = i + 1;
        }
    }
    return out;
}

// --- Payload cursor (decode, pure over a byte-buffer string) ------------------
struct BtCursor {
    pub s: string,
    pub pos: int,
    init(s: string) { self.s = s; self.pos = 0; }

    pub fn byte(self: BtCursor): int {
        let b = self.s[self.pos];
        self.pos = self.pos + 1;
        return b;
    }
    pub fn ushort(self: BtCursor): int {
        let hi = self.byte();
        let lo = self.byte();
        return hi * 256 + lo;
    }
    pub fn uint(self: BtCursor): int {
        let a = self.byte();
        let b = self.byte();
        let c = self.byte();
        let d = self.byte();
        return ((a * 256 + b) * 256 + c) * 256 + d;
    }
    pub fn str16(self: BtCursor): string {
        let n = self.ushort();
        let out = string.slice(self.s, self.pos, self.pos + n);
        self.pos = self.pos + n;
        return out;
    }
    pub fn skip(self: BtCursor, n: int): void { self.pos = self.pos + n; }
}

// --- Response decoders (pure; the offline gate calls these directly) ----------

/// Decode a RowDescription ('T') payload into typed columns.
/// Layout: field_count(u16) + per field {name(str16), table_id(u32), col_no(u16),
/// type_oid(u32), type_size(i16), type_mod(i32), format(u16)}.
pub fn decodeRowDesc(payload: string): List<Column> {
    let cols = List<Column>();
    let c = BtCursor(payload);
    let n = c.ushort();
    let i = 0;
    while (i < n) {
        let name = c.str16();
        c.skip(4);            // table_id
        c.skip(2);            // col_no
        let oid = c.uint();   // type_oid
        c.skip(2);            // type_size
        c.skip(4);            // type_mod
        c.skip(2);            // format (text on the simple-query path)
        cols.push(Column(name, oidToDbType(oid)));
        i = i + 1;
    }
    return cols;
}

// Decode one text-format value into a typed cell for the given column type.
fn decodeCell(t: DbType, raw: string, isNull: bool): DbValue {
    if (isNull) { return db.dbNull(); }
    if (t == DbType.Bool) {
        let tru = string.eql(raw, "true") || string.eql(raw, "t") || string.eql(raw, "1");
        return db.dbBool(tru);
    }
    if (t == DbType.Int4 || t == DbType.Uint4) { return db.dbInt(string.parseI64(raw)); }
    if (t == DbType.Int8 || t == DbType.Uint8 || t == DbType.Timestamp) { return db.dbLong(string.parseI64(raw)); }
    if (t == DbType.Float4 || t == DbType.Float8) { return db.dbDouble(string.parseFloat(raw)); }
    if (t == DbType.Decimal) {
        // S4: parse the exact text into a decimal128 (.dec, via asDecimal()); keep the raw
        // text in .s (asText) too.
        return DbValue(DbType.Decimal, 0, 0.0, decimal.fromString(raw), raw);
    }
    return db.dbText(raw);   // Text / Blob
}

/// Decode a DataRow ('D') payload into a typed Row, using the columns' types.
/// Layout: field_count(u16) + per field {len(i32, -1=NULL), bytes}.
pub fn decodeDataRow(payload: string, cols: List<Column>): Row {
    let row = Row();
    let c = BtCursor(payload);
    let n = c.ushort();
    let i = 0;
    while (i < n) {
        let len = c.uint();
        let col = cols.get(i) ?? Column("", DbType.Text);
        // NULL is the wire's -1 length. The 4 BE bytes 0xFFFFFFFF read back as the signed
        // i32 -1 (when int arithmetic is 32-bit) or as 4294967295 (when 64-bit) — accept both,
        // so the NULL sentinel is detected regardless of int width.
        if (len == 4294967295 || len == -1) {
            row.cells.push(decodeCell(col.type_oid, "", true));
        } else {
            let raw = string.slice(c.s, c.pos, c.pos + len);
            c.skip(len);
            row.cells.push(decodeCell(col.type_oid, raw, false));
        }
        i = i + 1;
    }
    return row;
}

/// Decode a CommandComplete ('C') payload -> tag string (e.g. "SELECT 2" / "OK 1").
pub fn decodeTag(payload: string): string {
    let c = BtCursor(payload);
    return c.str16();
}

/// Decode an Authentication ('R') payload -> the u32 method (0=Ok, 3=CleartextPassword, 10=SASL).
pub fn authMethod(payload: string): int {
    let c = BtCursor(payload);
    return c.uint();
}

/// Decode an ErrorResponse ('E') payload {severity(str16), code(str16), message(str16)}.
pub fn decodeError(payload: string): DbError {
    let c = BtCursor(payload);
    let sev = c.str16();
    let code = c.str16();
    let msg = c.str16();
    return DbError(code, msg);
}

// "OK 5" / "SELECT 3" -> the trailing count as a long (0 if absent).
fn tagCount(tag: string): int {
    let sp = string.lastIndexOf(tag, " ");
    if (sp == -1) { return 0; }
    let num = string.slice(tag, sp + 1, tag.length);
    return string.parseI64(num);
}

// --- Buffered frame reader over a live TCP stream ----------------------------
struct BtReader {
    pub io: aio.AsyncIO,   // A1 async-first: `fill` awaits io.recvInto (parks, no thread held)
    pub buf: ptr,
    pub cap: int,
    pub len: int,
    pub pos: int,
    init(io: aio.AsyncIO) {
        self.io = io;
        self.cap = 65536;
        self.buf = bytes.alloc(65536);
        self.len = 0;
        self.pos = 0;
    }

    // `buf` is a raw byte buffer (a `ptr`, not an ARC-managed field), so ARC will not free it — it needs
    // a cleanup hook, called only by the destructor. Without this the 64KB read buffer leaked per
    // connection (the BtReader end-to-end leak).
    fn delete(self: BtReader): void {
        if (self.buf != 0) {
            bytes.free(self.buf);
            self.buf = 0;
        }
    }
}
async fn fill(r: BtReader): bool {
    if (r.pos > 0) {
        let i = 0;
        while (r.pos + i < r.len) {
            bytes.write_byte(r.buf, i, bytes.read_byte(r.buf, r.pos + i));
            i = i + 1;
        }
        r.len = r.len - r.pos;
        r.pos = 0;
    }
    let space = r.cap - r.len;
    let n = await r.io.recvInto((r.buf + r.len) as int, space);   // parks the coroutine
    if (n <= 0) { return false; }
    r.len = r.len + n;
    return true;
}
async fn need(r: BtReader, k: int): bool {
    while (r.len - r.pos < k) { if (!(await fill(r))) { return false; } }
    return true;
}
fn rbyte(r: BtReader): int { let b = bytes.read_byte(r.buf, r.pos); r.pos = r.pos + 1; return b; }
fn ru32(r: BtReader): int {
    let a = rbyte(r); let b = rbyte(r); let c = rbyte(r); let d = rbyte(r);
    return ((a * 256 + b) * 256 + c) * 256 + d;
}

struct BtFrame {
    pub ftype: int,
    pub payload: string,
    init(ftype: int, payload: string) { self.ftype = ftype; self.payload = payload; }
}
async fn readFrame(r: BtReader): BtFrame {
    if (!(await need(r, 5))) { return BtFrame(-1, ""); }
    let t = rbyte(r);
    let len = ru32(r);
    let plen = len - 4;
    // Defensive: a corrupt/partial length (server crashed mid-stream, or a protocol
    // desync under concurrent load) must NOT reach bytes.alloc — a negative plen or a
    // multi-GB plen segfaults the client. Treat anything out of range as a broken
    // connection and return the error frame the callers already handle.
    if (plen < 0 || plen > 67108864) { return BtFrame(-1, ""); }
    if (plen > 0) {
        if (!(await need(r, plen))) { return BtFrame(-1, ""); }
    }
    let out = bytes.alloc(plen);
    let i = 0;
    while (i < plen) {
        bytes.write_byte(out, i, bytes.read_byte(r.buf, r.pos + i));
        i = i + 1;
    }
    r.pos = r.pos + plen;
    // Bind the `as string` cast to a local so it is registered as an owned temporary — an inline
    // `out as string` cast-of-a-buffer as a constructor arg is NOT tracked as owned (the ARC-edge in the
    // deferred backlog), so the frame payload leaked. Binding first is the clean pattern.
    let payload = out as string;
    return BtFrame(t, payload);
}

async fn sendFrame(io: aio.AsyncIO, frame: string): int {
    // Binary-safe: send exactly frame.length bytes (embedded NULs and all). Parks on the write.
    return await io.sendStr(frame);
}

// --- The seam implementation --------------------------------------------------

/// A live BTreeDB connection implementing the db.Connection seam.
pub struct BTreeConnection impl Connection {
    pub io: aio.AsyncIO,
    pub reader: BtReader,
    pub prepared: List<string>,   // D6: emulated prepared-statement cache (client-side substitution)
    pub busy: bool,               // concurrency guard: one in-flight request per connection
    init(io: aio.AsyncIO, reader: BtReader) {
        self.io = io;
        self.reader = reader;
        self.prepared = List<string>();
        self.busy = false;
    }

    // T9 concurrency guard: query/exec/queryPrepared/execPrepared are the frame-sending methods and each
    // hold `busy` for the duration of a request/response. A connection is a single request/response
    // channel; a second concurrent request would interleave frames and corrupt the stream. Refuse re-entry
    // instead (use a pool for concurrency). begin/commit/rollback delegate to exec, so they are protected
    // transitively and must NOT take their own guard, or the inner delegated call would falsely see `busy`
    // and reject. queryPrepared/execPrepared send their OWN extended-query frames (they do not delegate to
    // query/exec) so they take the guard directly.
    pub async fn query(self, sql: string, params: List<DbValue>): ResultSet {
        if (self.busy) { return db.errorResult(db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let finalSql = substituteParams(sql, params);
        let sn = await sendFrame(self.io, buildQueryFrame(finalSql));
        let rs = ResultSet();
        while (true) {
            let f = await readFrame(self.reader);
            if (f.ftype == -1) { break; }
            if (f.ftype == 90) { break; }                                   // 'Z' ReadyForQuery
            if (f.ftype == 84) { rs.columns = decodeRowDesc(f.payload); }   // 'T'
            if (f.ftype == 68) { rs.rows.push(decodeDataRow(f.payload, rs.columns)); } // 'D'
            if (f.ftype == 67) {                                            // 'C'
                rs.tag = decodeTag(f.payload);
                rs.rows_affected = tagCount(rs.tag);
            }
            if (f.ftype == 69) { rs.err = decodeError(f.payload); }         // 'E' ErrorResponse
        }
        self.busy = false;
        return rs;
    }

    pub async fn exec(self, sql: string, params: List<DbValue>): ExecResult {
        if (self.busy) { return errorExec(db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let finalSql = substituteParams(sql, params);
        let sn = await sendFrame(self.io, buildQueryFrame(finalSql));
        let tag = "";
        let err = noError();
        while (true) {
            let f = await readFrame(self.reader);
            if (f.ftype == -1) { break; }
            if (f.ftype == 90) { break; }
            if (f.ftype == 67) { tag = decodeTag(f.payload); }   // 'C'
            if (f.ftype == 69) { err = decodeError(f.payload); }  // 'E' ErrorResponse
        }
        self.busy = false;
        if (!err.isEmpty()) { return errorExec(err); }
        return ExecResult(tagCount(tag), tag);
    }

    pub fn close(self): void {
        // Sync trait method — just close the socket. A graceful Terminate would need an async send,
        // which cannot be driven here (close is often called from inside a coroutine, where a nested
        // drive would deadlock nova_run_root). An abrupt close is fine.
        self.io.close();
    }

    pub fn setTimeout(self, ms: int): int {   // D6 — async per-recv awaited deadline
        return self.io.setTimeout(ms);
    }

    // T14 prepared statements — REAL server-side Parse/Bind/Execute (extended query protocol).
    // prepare() caches the SQL text and returns a handle. queryPrepared/execPrepared then send
    // Parse+Bind+Execute+Sync so the SERVER substitutes the bound params (proto/command.zig), not the
    // client. The Parse is (re)issued per call because each param's declared type OID is derived from the
    // bound value's kind — the server maps OID -> escaping class, so the concrete param types must travel
    // with the Bind. The server replaces a same-named statement on re-Parse, so the per-handle name is
    // stable and cheap to re-declare.
    pub async fn prepare(self, sql: string): int {
        let i = 0;
        while (i < self.prepared.size()) {
            if (string.eql(self.prepared.get(i) ?? "", sql)) { return i; }
            i = i + 1;
        }
        self.prepared.push(sql);
        return self.prepared.size() - 1;
    }
    pub async fn queryPrepared(self, stmt: int, params: List<DbValue>): ResultSet {
        if (stmt < 0 || stmt >= self.prepared.size()) { return ResultSet(); }
        if (self.busy) { return db.errorResult(db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let sql = self.prepared.get(stmt) ?? "";
        let name = stmtName(stmt);
        let batch = buildParseFrame(name, sql, params) + buildBindFrame(name, name, params)
            + buildExecuteFrame(name, 0) + buildSyncFrame();
        let sn = await sendFrame(self.io, batch);
        let rs = ResultSet();
        while (true) {
            let f = await readFrame(self.reader);
            if (f.ftype == -1) { break; }
            if (f.ftype == 90) { break; }                                   // 'Z' ReadyForQuery (from Sync)
            if (f.ftype == 84) { rs.columns = decodeRowDesc(f.payload); }   // 'T' RowDescription
            if (f.ftype == 68) { rs.rows.push(decodeDataRow(f.payload, rs.columns)); } // 'D' DataRow
            if (f.ftype == 67) {                                            // 'C' CommandComplete
                rs.tag = decodeTag(f.payload);
                rs.rows_affected = tagCount(rs.tag);
            }
            if (f.ftype == 69) { rs.err = decodeError(f.payload); }         // 'E' ErrorResponse
            // '1' parse_complete (49), '2' bind_complete (50), 's' portal_suspended (115) are acks — ignore.
        }
        self.busy = false;
        return rs;
    }
    pub async fn execPrepared(self, stmt: int, params: List<DbValue>): ExecResult {
        if (stmt < 0 || stmt >= self.prepared.size()) { return ExecResult(0, ""); }
        if (self.busy) { return errorExec(db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let sql = self.prepared.get(stmt) ?? "";
        let name = stmtName(stmt);
        let batch = buildParseFrame(name, sql, params) + buildBindFrame(name, name, params)
            + buildExecuteFrame(name, 0) + buildSyncFrame();
        let sn = await sendFrame(self.io, batch);
        let tag = "";
        let err = noError();
        while (true) {
            let f = await readFrame(self.reader);
            if (f.ftype == -1) { break; }
            if (f.ftype == 90) { break; }                          // 'Z' ReadyForQuery (from Sync)
            if (f.ftype == 67) { tag = decodeTag(f.payload); }     // 'C' CommandComplete
            if (f.ftype == 69) { err = decodeError(f.payload); }   // 'E' ErrorResponse
        }
        self.busy = false;
        if (!err.isEmpty()) { return errorExec(err); }
        return ExecResult(tagCount(tag), tag);
    }

    // Transaction control (standard SQL).
    pub async fn begin(self): ExecResult { return await self.exec("BEGIN", List<DbValue>()); }
    pub async fn commit(self): ExecResult { return await self.exec("COMMIT", List<DbValue>()); }
    pub async fn rollback(self): ExecResult { return await self.exec("ROLLBACK", List<DbValue>()); }
}

/// The BTreeDB driver — `connect(dsn)` opens a connection. DSN is `host:port`.
// Whole connect + startup handshake as ONE async fn, driven once by the sync Driver.connect.
// Pull `key=value` out of a `?a=b&c=d` DSN query string (returns `dflt` if absent).
fn dsnParam(dsn: string, key: string, dflt: string): string {
    let needle = key + "=";
    let idx = string.indexOf(dsn, needle);
    if (idx == -1) { return dflt; }
    let rest = string.slice(dsn, idx + needle.length, dsn.length);
    let amp = string.indexOf(rest, "&");
    if (amp == -1) { return rest; }
    return string.slice(rest, 0, amp);
}

async fn btConnectAsync(dsn: string): BTreeConnection {
    let tlsOpt = dsnParam(dsn, "tls", "false");
    let useTls = string.eql(tlsOpt, "true") || string.eql(tlsOpt, "verify");
    let verify = string.eql(tlsOpt, "verify");
    let caFile = dsnParam(dsn, "tlsCAFile", "");

    let base = dsn;
    let qq = string.indexOf(base, "?");
    if (qq != -1) { base = string.slice(base, 0, qq); }

    // Credentials from the DSN. `user=`/`password=`/`db=` query params provide defaults; a
    // `user:pass@host:port` userinfo prefix (if present) overrides user/password. Real creds now
    // flow into the startup + auth handshake instead of the previously hardcoded "admin"/"nova".
    let user = dsnParam(dsn, "user", "admin");
    let password = dsnParam(dsn, "password", "");
    let dbname = dsnParam(dsn, "db", "nova");
    let at = string.indexOf(base, "@");
    if (at != -1) {
        let userinfo = string.slice(base, 0, at);
        base = string.slice(base, at + 1, base.length);
        let uc = string.indexOf(userinfo, ":");
        if (uc == -1) {
            user = userinfo;
        } else {
            user = string.slice(userinfo, 0, uc);
            password = string.slice(userinfo, uc + 1, userinfo.length);
        }
    }

    let colon = string.lastIndexOf(base, ":");
    let host = colon == -1 ? base : string.slice(base, 0, colon);
    let port = colon == -1 ? 3009 : string.parseI64(string.slice(base, colon + 1, base.length));

    // BTreeDB uses implicit TLS (the server serves TLS on the port when configured); tlsConnect[Verify]
    // is the whole client story. Both return an AsyncIO the connection holds transparently.
    if (useTls) {
        if (verify) {
            let caPem = if (caFile != "") File.readText(caFile) else "";
            let ts = await asynctls.tlsConnectVerify(host, port, caPem);
            return await btStartup(ts, user, dbname, password);
        }
        let ts2 = await asynctls.tlsConnect(host, port, false);
        return await btStartup(ts2, user, dbname, password);
    }
    let stream = await aio.asyncConnect(host, port);
    return await btStartup(stream, user, dbname, password);
}

// Run startup over `io` (plaintext AsyncStream or TlsStream, both AsyncIO). Passing the concrete stream
// into this AsyncIO param is a widening (the safe direction). The startup frame carries the DSN user +
// database; if the server issues an AuthenticationCleartextPassword request ('R' method 3), the DSN
// password is sent back as a 'p' frame. NOTE: today's btree server (proto/session.zig) accepts startup
// unconditionally — it replies AuthOk (method 0) without challenging — so the password path is dormant
// but correct-by-construction for when the server enforces auth. SASL (method 10) is not yet supported.
async fn btStartup(io: aio.AsyncIO, user: string, dbname: string, password: string): BTreeConnection {
    let reader = BtReader(io);
    let sn = await sendFrame(io, buildStartupFrame(user, dbname));
    while (true) {
        let f = await readFrame(reader);
        if (f.ftype == -1) { break; }
        if (f.ftype == 82) {                     // 'R' Authentication request
            let method = authMethod(f.payload);
            if (method == 3) {                   // AuthenticationCleartextPassword
                let ps = await sendFrame(io, buildPasswordFrame(password));
            }
        }
        if (f.ftype == 90) { break; }            // 'Z' ReadyForQuery
    }
    return BTreeConnection(io, reader);
}

pub struct BTreeDriver impl Driver {
    pub async fn connect(self, dsn: string): Connection {
        return await btConnectAsync(dsn);   // sync trait method drives the async connect once
    }
}
