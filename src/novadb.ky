// novadb.ky — the NovaDB driver SEAM: KyteConnection (impl db.Connection) and
// KyteDriver (impl db.Driver) over the standardized binary wire protocol. This module
// orchestrates the connection lifecycle + the request/response loops; every other
// responsibility lives in its own module (SOLID/SRP):
//
//   connection      connection-string parsing        (ConnectionOptions, parse)
//   codec    the binary wire codec            (build* frames + decode* responses, stmtName)
//   typemap  OID<->DbType + value<->SQL/bind  (oidToDbType, decodeCell, substituteParams)
//   proto    async transport framing          (BtReader, BtFrame, readFrame, sendFrame)
//
// KyteConnection/KyteDriver are the only names consumers touch: `import novadb; KyteDriver()`.
//
//   let drv = KyteDriver();
//   let conn = drv.connect("127.0.0.1:3009");
//   let rs = conn.query("SELECT id, name FROM users", List<DbValue>());
//   let id = rs.row(0).getInt(0);   // typed, not a string
//
// The simple-query path ('Q') carries TEXT-format values (btree proto/wire.zig FieldDesc
// defaults format=text and the executor materializes cells as text); this driver captures
// each column's type OID from RowDescription and decodes each DataRow cell into a typed
// db.DbValue accordingly — unlike data/btree/client.ky, which keeps every cell a string.
//
// The wire CODEC (frame build + response decode + param substitution) is pure over byte
// buffers, so it is gated offline (64-bit-verified) without a live server; the connect/
// query methods wire that codec to a TcpStream and need a running NovaDB to exercise.
import net.aio;
import net.asynctls;
import io.file;
import bytes;
import string;
import list;
import db;
import connection;
import codec;
import typemap;
import proto;

// --- The seam implementation --------------------------------------------------

// The DbError raised when a request cannot reach the server or the response ends
// before ReadyForQuery: a send that returned < 0, or a read that hit EOF / a short
// read / a corrupt frame length. SQLSTATE 08006 is connection_failure. Callers check
// `.hasError()` / `err.code == "08006"` to tell a dead connection apart from an
// ordinary empty result, which they otherwise look identical to.
fn connLost(): DbError { return db.DbError("08006", "connection to NovaDB lost"); }

/// A live NovaDB connection implementing the db.Connection seam.
pub struct KyteConnection impl Connection {
    pub io: aio.AsyncIO,
    pub reader: BtReader,
    pub prepared: List<string>,   // D6: emulated prepared-statement cache (client-side substitution)
    pub busy: bool,               // concurrency guard: one in-flight request per connection
    init(io: aio.AsyncIO, reader: BtReader) {
        self.io = io;
        self.reader = reader;
        self.prepared = List<string>();
        self.busy = false;
    }

    // T9 concurrency guard: query/exec/queryPrepared/execPrepared are the frame-sending methods and each
    // hold `busy` for the duration of a request/response. A connection is a single request/response
    // channel; a second concurrent request would interleave frames and corrupt the stream. Refuse re-entry
    // instead (use a pool for concurrency). begin/commit/rollback delegate to exec, so they are protected
    // transitively and must NOT take their own guard, or the inner delegated call would falsely see `busy`
    // and reject. queryPrepared/execPrepared send their OWN extended-query frames (they do not delegate to
    // query/exec) so they take the guard directly.
    pub async fn query(self, sql: string, params: List<DbValue>): ResultSet {
        if (self.busy) { return db.errorResult(db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let finalSql = typemap.substituteParams(sql, params);
        let sn = await proto.sendFrame(self.io, codec.buildQueryFrame(finalSql));
        if (sn < 0) { self.busy = false; return db.errorResult(connLost()); }
        let rs = ResultSet();
        while (true) {
            let f = await proto.readFrame(self.reader);
            // A -1 frame is a DIRTY end (EOF / short read / corrupt length) before the
            // server's ReadyForQuery ('Z', 90). Distinguish it from a clean completion:
            // flag the transport loss so callers see .hasError() rather than a silent
            // empty-but-ok result (which reads exactly like "no rows").
            if (f.ftype == -1) { if (rs.err.isEmpty()) { rs.err = connLost(); } break; }
            if (f.ftype == 90) { break; }                                   // 'Z' ReadyForQuery
            if (f.ftype == 84) { rs.columns = codec.decodeRowDesc(f.payload); }   // 'T'
            if (f.ftype == 68) { rs.rows.push(codec.decodeDataRow(f.payload, rs.columns)); } // 'D'
            if (f.ftype == 67) {                                            // 'C'
                rs.tag = codec.decodeTag(f.payload);
                rs.rows_affected = codec.tagCount(rs.tag);
            }
            if (f.ftype == 69) { rs.err = codec.decodeError(f.payload); }         // 'E' ErrorResponse
        }
        self.busy = false;
        return rs;
    }

    // T1: satisfy the Connection seam's queryWire via the generic re-encode fallback. This driver's simple-
    // query path already materialises a ResultSet, so we re-encode it into WireRows' canonical layout; a
    // zero-materialisation override (like pg/mysql's direct text path) can come later if it shows up in a
    // profile. Without this the driver does not satisfy the trait and any app importing it fails to build.
    pub async fn queryWire(self, sql: string, params: List<DbValue>): WireRows {
        return db.wireRowsFromResultSet(await self.query(sql, params));
    }

    pub async fn exec(self, sql: string, params: List<DbValue>): ExecResult {
        if (self.busy) { return errorExec(db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let finalSql = typemap.substituteParams(sql, params);
        let sn = await proto.sendFrame(self.io, codec.buildQueryFrame(finalSql));
        if (sn < 0) { self.busy = false; return errorExec(connLost()); }
        let tag = "";
        let err = noError();
        while (true) {
            let f = await proto.readFrame(self.reader);
            if (f.ftype == -1) { if (err.isEmpty()) { err = connLost(); } break; }
            if (f.ftype == 90) { break; }
            if (f.ftype == 67) { tag = codec.decodeTag(f.payload); }   // 'C'
            if (f.ftype == 69) { err = codec.decodeError(f.payload); }  // 'E' ErrorResponse
        }
        self.busy = false;
        if (!err.isEmpty()) { return errorExec(err); }
        return ExecResult(codec.tagCount(tag), tag);
    }

    pub fn close(self): void {
        // Sync trait method — just close the socket. A graceful Terminate would need an async send,
        // which cannot be driven here (close is often called from inside a coroutine, where a nested
        // drive would deadlock kyte_run_root). An abrupt close is fine.
        self.io.close();
    }

    pub fn setTimeout(self, ms: int): int {   // D6 — async per-recv awaited deadline
        return self.io.setTimeout(ms);
    }

    // T14 prepared statements — REAL server-side Parse/Bind/Execute (extended query protocol).
    // prepare() caches the SQL text and returns a handle. queryPrepared/execPrepared then send
    // Parse+Bind+Execute+Sync so the SERVER substitutes the bound params (proto/command.zig), not the
    // client. The Parse is (re)issued per call because each param's declared type OID is derived from the
    // bound value's kind — the server maps OID -> escaping class, so the concrete param types must travel
    // with the Bind. The server replaces a same-named statement on re-Parse, so the per-handle name is
    // stable and cheap to re-declare.
    pub async fn prepare(self, sql: string): int {
        let i = 0;
        while (i < self.prepared.size()) {
            if (string.eql(self.prepared.get(i) ?? "", sql)) { return i; }
            i = i + 1;
        }
        self.prepared.push(sql);
        return self.prepared.size() - 1;
    }
    pub async fn queryPrepared(self, stmt: int, params: List<DbValue>): ResultSet {
        if (stmt < 0 || stmt >= self.prepared.size()) { return ResultSet(); }
        if (self.busy) { return db.errorResult(db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let sql = self.prepared.get(stmt) ?? "";
        let name = codec.stmtName(stmt);
        let batch = codec.buildParseFrame(name, sql, params) + codec.buildBindFrame(name, name, params)
            + codec.buildExecuteFrame(name, 0) + codec.buildSyncFrame();
        let sn = await proto.sendFrame(self.io, batch);
        if (sn < 0) { self.busy = false; return db.errorResult(connLost()); }
        let rs = ResultSet();
        while (true) {
            let f = await proto.readFrame(self.reader);
            if (f.ftype == -1) { if (rs.err.isEmpty()) { rs.err = connLost(); } break; }
            if (f.ftype == 90) { break; }                                   // 'Z' ReadyForQuery (from Sync)
            if (f.ftype == 84) { rs.columns = codec.decodeRowDesc(f.payload); }   // 'T' RowDescription
            if (f.ftype == 68) { rs.rows.push(codec.decodeDataRow(f.payload, rs.columns)); } // 'D' DataRow
            if (f.ftype == 67) {                                            // 'C' CommandComplete
                rs.tag = codec.decodeTag(f.payload);
                rs.rows_affected = codec.tagCount(rs.tag);
            }
            if (f.ftype == 69) { rs.err = codec.decodeError(f.payload); }         // 'E' ErrorResponse
            // '1' parse_complete (49), '2' bind_complete (50), 's' portal_suspended (115) are acks — ignore.
        }
        self.busy = false;
        return rs;
    }
    pub async fn execPrepared(self, stmt: int, params: List<DbValue>): ExecResult {
        if (stmt < 0 || stmt >= self.prepared.size()) { return ExecResult(0, ""); }
        if (self.busy) { return errorExec(db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let sql = self.prepared.get(stmt) ?? "";
        let name = codec.stmtName(stmt);
        let batch = codec.buildParseFrame(name, sql, params) + codec.buildBindFrame(name, name, params)
            + codec.buildExecuteFrame(name, 0) + codec.buildSyncFrame();
        let sn = await proto.sendFrame(self.io, batch);
        if (sn < 0) { self.busy = false; return errorExec(connLost()); }
        let tag = "";
        let err = noError();
        while (true) {
            let f = await proto.readFrame(self.reader);
            if (f.ftype == -1) { if (err.isEmpty()) { err = connLost(); } break; }
            if (f.ftype == 90) { break; }                          // 'Z' ReadyForQuery (from Sync)
            if (f.ftype == 67) { tag = codec.decodeTag(f.payload); }     // 'C' CommandComplete
            if (f.ftype == 69) { err = codec.decodeError(f.payload); }   // 'E' ErrorResponse
        }
        self.busy = false;
        if (!err.isEmpty()) { return errorExec(err); }
        return ExecResult(codec.tagCount(tag), tag);
    }

    // Transaction control (standard SQL).
    pub async fn begin(self): ExecResult { return await self.exec("BEGIN", List<DbValue>()); }
    pub async fn commit(self): ExecResult { return await self.exec("COMMIT", List<DbValue>()); }
    pub async fn rollback(self): ExecResult { return await self.exec("ROLLBACK", List<DbValue>()); }

    // --- Document model (NovaDB 'J' doc opcode) -------------------------------
    // NovaDB-specific methods (not part of the generic SQL Connection seam). They
    // exchange raw BSON byte-strings: the app builds a document/filter with
    // std/serde/bson and parses the returned documents the same way. Each takes the
    // `busy` guard like query/exec — one in-flight request per connection.

    /// Create a collection if it does not already exist (idempotent server-side).
    pub async fn createCollection(self, name: string): ExecResult {
        return await self.docExec(codec.buildDocCreateCollectionFrame(name));
    }
    /// Insert one BSON document into `collection`. If the document has no `_id`
    /// the server generates one.
    pub async fn insertDoc(self, collection: string, bson: string): ExecResult {
        return await self.docExec(codec.buildDocInsertFrame(collection, bson));
    }
    /// Insert-if-absent: insert one document, failing with a 23505 duplicate-key
    /// error if a document with the same `_id` already exists (the server also
    /// generates an `_id` when absent, in which case a collision is impossible).
    pub async fn insertUniqueDoc(self, collection: string, bson: string): ExecResult {
        return await self.docExec(codec.buildDocInsertUniqueFrame(collection, bson));
    }
    /// Read the document-path observability counters. The single returned BSON
    /// document is `{finds, inserts, deletes, updates, docsScanned, docsMatched}`.
    pub async fn docStats(self, collection: string): DocResult {
        return await self.docQuery(codec.buildDocStatsFrame(collection));
    }
    /// Insert many documents in one round trip. `docsEnvelope` is a BSON document
    /// with a `docs` array field; the server generates an `_id` for any element
    /// that lacks one.
    pub async fn insertManyDocs(self, collection: string, docsEnvelope: string): ExecResult {
        return await self.docExec(codec.buildDocInsertManyFrame(collection, docsEnvelope));
    }
    /// Create a secondary index on `path` (a plain or dotted field path).
    pub async fn createIndex(self, collection: string, path: string): ExecResult {
        return await self.docExec(codec.buildDocCreateIndexFrame(collection, path));
    }
    /// Create a UNIQUE index on `path`: a write giving a second document the same
    /// value then fails with a 23505 duplicate-key error.
    pub async fn createUniqueIndex(self, collection: string, path: string): ExecResult {
        return await self.docExec(codec.buildDocCreateUniqueIndexFrame(collection, path));
    }
    /// Update every document matching the BSON `filter` with the update `spec`
    /// (`$set`/`$unset`/`$inc`). Returns the count in the command tag.
    pub async fn updateDocs(self, collection: string, filter: string, spec: string): ExecResult {
        return await self.docExec(codec.buildDocUpdateFrame(collection, filter, spec));
    }
    /// Delete every document matching the BSON `filter`.
    pub async fn deleteDocs(self, collection: string, filter: string): ExecResult {
        return await self.docExec(codec.buildDocDeleteFrame(collection, filter));
    }
    /// Update matching documents, or insert one seeded from `filter` + `spec`
    /// when none match (upsert).
    pub async fn upsertDocs(self, collection: string, filter: string, spec: string): ExecResult {
        return await self.docExec(codec.buildDocUpsertFrame(collection, filter, spec));
    }
    /// Apply a mixed batch of writes in one request. `opsEnvelope` is a BSON
    /// document with an `ops` array: `{op:"insert",doc}`, `{op:"update",filter,
    /// update}`, `{op:"upsert",filter,update}`, or `{op:"delete",filter}`.
    pub async fn bulkWrite(self, collection: string, opsEnvelope: string): ExecResult {
        return await self.docExec(codec.buildDocBulkWriteFrame(collection, opsEnvelope));
    }
    /// Return every document in `collection` matching the BSON `filter` (`{}` = all).
    pub async fn findDocs(self, collection: string, filter: string): DocResult {
        return await self.docQuery(codec.buildDocFindFrame(collection, filter));
    }
    /// Return the first document matching the BSON `filter` (zero or one document).
    pub async fn findOneDoc(self, collection: string, filter: string): DocResult {
        return await self.docQuery(codec.buildDocFindOneFrame(collection, filter));
    }
    /// Find with result shaping. `envelope` is a BSON document with optional
    /// `filter`, `projection`, `sort` sub-documents and `skip`/`limit` integers.
    pub async fn findQueryDocs(self, collection: string, envelope: string): DocResult {
        return await self.docQuery(codec.buildDocFindQueryFrame(collection, envelope));
    }
    /// Count documents matching the BSON `filter`. The result is a single BSON
    /// document `{ n: <count> }`; the app parses `n` out of it.
    pub async fn countDocs(self, collection: string, filter: string): DocResult {
        return await self.docQuery(codec.buildDocCountFrame(collection, filter));
    }
    /// Run an aggregation pipeline over `collection`. `pipeline` is a BSON
    /// document `{stages: [ ... ]}` where each stage is a one-key document
    /// (`$match`/`$group`/`$sort`/`$skip`/`$limit`/`$project`/`$count`). Returns
    /// the pipeline output documents.
    pub async fn aggregateDocs(self, collection: string, pipeline: string): DocResult {
        return await self.docQuery(codec.buildDocAggregateFrame(collection, pipeline));
    }
    /// Fetch one cursor page. `envelope` is a BSON document with an optional
    /// `filter`, an optional `after` (a 12-byte `_id` to resume past), and an
    /// optional `batch` size. The returned page carries the documents and the id
    /// to resume after (empty when the collection is exhausted).
    pub async fn findCursor(self, collection: string, envelope: string): DocCursorResult {
        return await self.docCursorQuery(codec.buildDocFindCursorFrame(collection, envelope));
    }

    // Send a write-style doc frame (create/insert) and drain to ReadyForQuery,
    // returning the command tag or the server error.
    async fn docExec(self, frame: string): ExecResult {
        if (self.busy) { return errorExec(db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let sn = await proto.sendFrame(self.io, frame);
        if (sn < 0) { self.busy = false; return errorExec(connLost()); }
        let tag = "";
        let err = noError();
        while (true) {
            let f = await proto.readFrame(self.reader);
            if (f.ftype == -1) { if (err.isEmpty()) { err = connLost(); } break; }
            if (f.ftype == 90) { break; }                                // 'Z' ReadyForQuery
            if (f.ftype == 67) { tag = codec.decodeTag(f.payload); }     // 'C' CommandComplete
            if (f.ftype == 69) { err = codec.decodeError(f.payload); }   // 'E' ErrorResponse
        }
        self.busy = false;
        if (!err.isEmpty()) { return errorExec(err); }
        return ExecResult(codec.tagCount(tag), tag);
    }

    // Send a read-style doc frame (find/find_one) and collect the doc-result ('j')
    // frames into a DocResult.
    async fn docQuery(self, frame: string): DocResult {
        if (self.busy) { return DocResult(List<string>(), db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let sn = await proto.sendFrame(self.io, frame);
        if (sn < 0) { self.busy = false; return DocResult(List<string>(), connLost()); }
        let docs = List<string>();
        let err = noError();
        while (true) {
            let f = await proto.readFrame(self.reader);
            if (f.ftype == -1) { if (err.isEmpty()) { err = connLost(); } break; }
            if (f.ftype == 90) { break; }                                // 'Z' ReadyForQuery
            if (f.ftype == 106) {                                        // 'j' document result
                let part = codec.decodeDocResult(f.payload);
                let i = 0;
                while (i < part.size()) { docs.push(part.get(i) ?? ""); i = i + 1; }
            }
            if (f.ftype == 69) { err = codec.decodeError(f.payload); }   // 'E' ErrorResponse
        }
        self.busy = false;
        return DocResult(docs, err);
    }

    // Send a cursor find frame and collect the cursor page ('j' with a next id).
    async fn docCursorQuery(self, frame: string): DocCursorResult {
        if (self.busy) { return DocCursorResult(List<string>(), "", db.DbError("", "connection busy: concurrent use")); }
        self.busy = true;
        let sn = await proto.sendFrame(self.io, frame);
        if (sn < 0) { self.busy = false; return DocCursorResult(List<string>(), "", connLost()); }
        let docs = List<string>();
        let next = "";
        let err = noError();
        while (true) {
            let f = await proto.readFrame(self.reader);
            if (f.ftype == -1) { if (err.isEmpty()) { err = connLost(); } break; }
            if (f.ftype == 90) { break; }                                // 'Z' ReadyForQuery
            if (f.ftype == 106) {                                        // 'j' cursor page
                let page = codec.decodeDocCursorResult(f.payload);
                let i = 0;
                while (i < page.docs.size()) { docs.push(page.docs.get(i) ?? ""); i = i + 1; }
                next = page.next;
            }
            if (f.ftype == 69) { err = codec.decodeError(f.payload); }   // 'E' ErrorResponse
        }
        self.busy = false;
        return DocCursorResult(docs, next, err);
    }
}

/// A cursor page result: the matched BSON documents, the id to resume after
/// (empty string when the collection is exhausted), and any server error.
pub struct DocCursorResult {
    pub docs: List<string>,
    pub next: string,
    pub err: DbError,
    init(docs: List<string>, next: string, err: DbError) { self.docs = docs; self.next = next; self.err = err; }
    pub fn hasError(self): bool { return !self.err.isEmpty(); }
    pub fn size(self): int { return self.docs.size(); }
    pub fn exhausted(self): bool { return self.next == ""; }
}

/// A document query result: the matched BSON documents (each a raw byte-string) plus
/// any server error. Mirrors ResultSet for the document path; the app parses each
/// document with std/serde/bson.
pub struct DocResult {
    pub docs: List<string>,
    pub err: DbError,
    init(docs: List<string>, err: DbError) { self.docs = docs; self.err = err; }
    pub fn hasError(self): bool { return !self.err.isEmpty(); }
    pub fn size(self): int { return self.docs.size(); }
}

/// The NovaDB driver — `connect(connectionString)` opens a connection. connection string is `host:port`.
// Whole connect + startup handshake as ONE async fn, driven once by the sync Driver.connect.
// connection string parsing lives in the connection module (pure string work); this fn wires the parsed ConnectionOptions to the socket/TLS.
async fn btConnectAsync(connectionString: string): KyteConnection {
    let d = connection.parse(connectionString);

    // NovaDB uses implicit TLS (the server serves TLS on the port when configured); tlsConnect[Verify]
    // is the whole client story. Both return an AsyncIO the connection holds transparently.
    if (d.useTls) {
        if (d.verify) {
            let caPem = if (d.caFile != "") File.readText(d.caFile) else "";
            let ts = await asynctls.tlsConnectVerify(d.host, d.port, caPem);
            return await btStartup(ts, d.user, d.dbname, d.password);
        }
        let ts2 = await asynctls.tlsConnect(d.host, d.port, false);
        return await btStartup(ts2, d.user, d.dbname, d.password);
    }
    let stream = await aio.asyncConnect(d.host, d.port);
    return await btStartup(stream, d.user, d.dbname, d.password);
}

// Run startup over `io` (plaintext AsyncStream or TlsStream, both AsyncIO). Passing the concrete stream
// into this AsyncIO param is a widening (the safe direction). The startup frame carries the connection string user +
// database; if the server issues an AuthenticationCleartextPassword request ('R' method 3), the connection string
// password is sent back as a 'p' frame. NOTE: today's btree server (proto/session.zig) accepts startup
// unconditionally — it replies AuthOk (method 0) without challenging — so the password path is dormant
// but correct-by-construction for when the server enforces auth. SASL (method 10) is not yet supported.
async fn btStartup(io: aio.AsyncIO, user: string, dbname: string, password: string): KyteConnection {
    let reader = BtReader(io);
    let sn = await proto.sendFrame(io, codec.buildStartupFrame(user, dbname));
    while (true) {
        let f = await proto.readFrame(reader);
        if (f.ftype == -1) { break; }
        if (f.ftype == 82) {                     // 'R' Authentication request
            let method = codec.authMethod(f.payload);
            if (method == 3) {                   // AuthenticationCleartextPassword
                let ps = await proto.sendFrame(io, codec.buildPasswordFrame(password));
            }
        }
        if (f.ftype == 90) { break; }            // 'Z' ReadyForQuery
    }
    return KyteConnection(io, reader);
}

pub struct KyteDriver impl Driver {
    pub async fn connect(self, connectionString: string): Connection {
        return await btConnectAsync(connectionString);   // sync trait method drives the async connect once
    }
}
