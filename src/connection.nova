// connection: NovaDB connection-string parsing (SRP: connection string only).
// `novadb://user[:password]@host[:port]/... ?db=..&tls=..&tlsCAFile=..`  (host:port is the
// minimal form; the query params + `user:pass@` userinfo supply the rest). Pure string work;
// no I/O, no db seam. The seam (novadb.nova) turns a ConnectionOptions into a live connection.
import string;

pub struct ConnectionOptions {
    pub host: string,
    pub port: int,
    pub user: string,
    pub password: string,
    pub dbname: string,
    pub useTls: bool,      // tls=true|verify
    pub verify: bool,      // tls=verify (validate the server cert against tlsCAFile)
    pub caFile: string,    // path to a PEM CA bundle (verify)
    init(host: string, port: int, user: string, password: string, dbname: string, useTls: bool, verify: bool, caFile: string) {
        self.host = host; self.port = port; self.user = user;
        self.password = password; self.dbname = dbname;
        self.useTls = useTls; self.verify = verify; self.caFile = caFile;
    }
}

// Pull `key=value` out of a `?a=b&c=d` connection string query string (returns `dflt` if absent).
fn queryParam(connectionString: string, key: string, dflt: string): string {
    let needle = key + "=";
    let idx = string.indexOf(connectionString, needle);
    if (idx == -1) { return dflt; }
    let rest = string.slice(connectionString, idx + needle.length, connectionString.length);
    let amp = string.indexOf(rest, "&");
    if (amp == -1) { return rest; }
    return string.slice(rest, 0, amp);
}

// Parse the connection string into its parts. connection string is `host:port` with optional `user:pass@` userinfo prefix and
// `?db=..&tls=..&tlsCAFile=..` query params.
pub fn parse(connectionString: string): ConnectionOptions {
    let tlsOpt = queryParam(connectionString, "tls", "false");
    let useTls = string.eql(tlsOpt, "true") || string.eql(tlsOpt, "verify");
    let verify = string.eql(tlsOpt, "verify");
    let caFile = queryParam(connectionString, "tlsCAFile", "");

    let base = connectionString;
    let qq = string.indexOf(base, "?");
    if (qq != -1) { base = string.slice(base, 0, qq); }

    // Strip an optional `scheme://` prefix so the advertised URL form works, not just the bare
    // `host:port`. Both `novadb://user:pass@host:port?db=shop` and `host:port` now parse the same.
    // Must happen before the host:port split, since the `://` colons would otherwise fool lastIndexOf.
    let sep = string.indexOf(base, "://");
    if (sep != -1) { base = string.slice(base, sep + 3, base.length); }

    // Credentials from the connection string. `user=`/`password=`/`db=` query params provide defaults; a
    // `user:pass@host:port` userinfo prefix (if present) overrides user/password. Real creds now
    // flow into the startup + auth handshake instead of the previously hardcoded "admin"/"nova".
    let user = queryParam(connectionString, "user", "admin");
    let password = queryParam(connectionString, "password", "");
    let dbname = queryParam(connectionString, "db", "nova");
    let at = string.indexOf(base, "@");
    if (at != -1) {
        let userinfo = string.slice(base, 0, at);
        base = string.slice(base, at + 1, base.length);
        let uc = string.indexOf(userinfo, ":");
        if (uc == -1) {
            user = userinfo;
        } else {
            user = string.slice(userinfo, 0, uc);
            password = string.slice(userinfo, uc + 1, userinfo.length);
        }
    }

    // A trailing `/path` (e.g. `host:port/shop`) is not the port; drop it before the host:port split.
    let slash = string.indexOf(base, "/");
    if (slash != -1) { base = string.slice(base, 0, slash); }

    let colon = string.lastIndexOf(base, ":");
    let host = colon == -1 ? base : string.slice(base, 0, colon);
    let port = colon == -1 ? 3009 : string.parseI64(string.slice(base, colon + 1, base.length));

    return ConnectionOptions(host, port, user, password, dbname, useTls, verify, caFile);
}
